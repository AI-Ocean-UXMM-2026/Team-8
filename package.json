{
  "name": "parcelcare",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "dev": "npm run prepare:ui && next dev",
    "build": "npm run prepare:ui && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "npm run prepare:ui && tsc --noEmit",
    "test": "node scripts/check-migration.mjs && node check-reports.cjs && node check-maker.cjs && node check-rules.cjs && node check-autofill.cjs && node check-priority.cjs && node check-priority-reports.cjs",
    "test:browser": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "playwright": "^1.56.0",
    "typescript": "^5.9.0"
  },
  "engines": { "node": ">=24 <25" }
}
