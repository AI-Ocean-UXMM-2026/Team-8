{
  "name": "parcelcare",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "contracts:generate": "node scripts/python.mjs scripts/export-contracts.py && npm run contracts:types",
    "contracts:types": "openapi-typescript contracts/openapi.json -o contracts/generated/api.d.ts",
    "test:contracts": "node scripts/python.mjs scripts/check-contracts.py && node scripts/check-contract-types.mjs",
    "test:frontend": "tsc -p tests/frontend/tsconfig.json && node --test .test-build/tests/frontend/api.test.js .test-build/tests/frontend/warehouse.test.js .test-build/tests/frontend/roles.test.js .test-build/tests/frontend/courier.test.js .test-build/tests/frontend/maps.test.js .test-build/tests/frontend/ux-writing.test.js .test-build/tests/frontend/orders.test.js",
    "test:warehouse": "tsc -p tests/frontend/tsconfig.json && node scripts/check-warehouse.mjs",
    "test:tracking": "tsc -p tests/frontend/tsconfig.json && node scripts/check-tracking-polling.mjs",
    "test:maker-checker": "npm run prepare:ui && tsc -p tests/frontend/tsconfig.json && node scripts/check-maker-checker.mjs",
    "test:backend": "node scripts/python.mjs -m unittest discover -s api/tests -v",
    "test:database": "npm test --prefix supabase/tests",
    "check:migrations": "node scripts/check-migrations.mjs",
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "dev": "npm run prepare:ui && next dev",
    "build": "npm run prepare:ui && next build --webpack",
    "start": "next start -H 0.0.0.0",
    "typecheck": "npm run prepare:ui && tsc --noEmit",
    "test": "node scripts/check-migration.mjs && node check-reports.cjs && node check-maker.cjs && node check-rules.cjs && node check-autofill.cjs && node check-priority.cjs && node check-priority-reports.cjs && node check-dashboard-workflows.cjs",
    "test:browser": "node scripts/check-browser.mjs",
    "test:report-locales": "node scripts/check-report-locales.mjs",
    "test:localization": "node scripts/check-localization.mjs",
    "test:dashboard-workflows": "node scripts/check-dashboard-workflows.mjs",
    "test:sme-workspace": "node scripts/check-sme-workspace.mjs",
    "test:categorization:database": "node supabase/tests/categorization.test.mjs",
    "test:categorization:ui": "node scripts/check-categorization-ui.mjs",
    "test:sla:database": "node supabase/tests/sla.test.mjs",
    "test:sla:ui": "node scripts/check-sla-ui.mjs",
    "test:office": "node scripts/check-office.mjs",
    "test:portals": "node scripts/check-portals.mjs",
    "test:rbac:browser": "node scripts/check-rbac.mjs",
    "test:reports:browser": "node scripts/check-report-portals.mjs",
    "test:maps": "tsc -p tests/frontend/tsconfig.json && node --test .test-build/tests/frontend/maps.test.js",
    "test:maps:browser": "node scripts/check-map-sync.mjs",
    "test:maps:live": "node scripts/check-map-live.mjs",
    "test:orders:browser": "node scripts/check-orders.mjs",
    "test:orders:database": "node supabase/tests/orders.test.mjs",
    "test:outbound:database": "node supabase/tests/outbound.test.mjs",
    "test:outbound:browser": "node scripts/check-outbound.mjs",
    "test:shared-stock:database": "node supabase/tests/shared-stock.test.mjs",
    "test:exception-workflow": "node scripts/check-sme-live-workflow.mjs",
    "test:illustrated-preview": "node scripts/check-illustrated-preview.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.7.0",
    "@base-ui/react": "^1.9.0",
    "@phosphor-icons/react": "^2.1.10",
    "cn": "^0.5.0",
    "geist": "^1.8.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.56.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
