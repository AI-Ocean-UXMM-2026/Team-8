# Optional Next.js server-to-server API URL. No backend is required in demo mode.
PARCELCARE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_PARCELCARE_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never expose Supabase secret keys or OpenAI API keys as NEXT_PUBLIC variables.
# Optional Nominatim-compatible search endpoint. Myanmar-only explicit search.
# Public default is suitable for a single server (one request/second).
# For multiple instances use a provider with a shared rate limit or self-hosted endpoint.
PARCELCARE_GEOCODER_URL=https://nominatim.openstreetmap.org/search
