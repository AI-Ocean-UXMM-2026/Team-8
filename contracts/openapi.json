  "components": {
    "schemas": {
      "ApprovalSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "decided",
              "cancelled"
            ],
            "title": "Status",
            "type": "string"
          },
          "decision": {
            "anyOf": [
              {
                "enum": [
                  "accept_partial",
                  "await_remainder",
                  "reject"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Decision"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          }
        },
        "required": [
          "id",
          "case_id",
          "status",
          "decision",
          "created_at"
        ],
        "title": "ApprovalSummary",
        "type": "object"
      },
      "CaseSummary": {
        "additionalProperties": false,
        "properties": {
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "shipment_id": {
            "format": "uuid",
            "title": "Shipment Id",
            "type": "string"
          },
          "stage": {
            "enum": [
              "inbound",
              "warehouse",
              "outbound"
            ],
            "title": "Stage",
            "type": "string"
          },
          "type": {
            "enum": [
              "quantity_mismatch",
              "damaged_goods",
              "missing_stock",
              "wrong_pick",
              "short_pick",
              "courier_delay",
              "delivery_failed",
              "recipient_unavailable",
              "transit_damage",
              "transit_loss"
            ],
            "title": "Type",
            "type": "string"
          },
          "priority": {
            "enum": [
              "low",
              "normal",
              "high",
              "critical"
            ],
            "title": "Priority",
            "type": "string"
          },
          "status": {
            "enum": [
              "new",
              "investigating",
              "processing",
              "awaiting_information",
              "awaiting_sme_decision",
              "awaiting_courier_confirmation",
              "awaiting_verification",
              "resolved",
              "closed"
            ],
            "title": "Status",
            "type": "string"
          },
          "handling_mode": {
            "enum": [
              "ai",
              "human"
            ],
            "title": "Handling Mode",
            "type": "string"
          },
          "responsible_party": {
            "enum": [
              "WAREHOUSE",
              "THIRD_PARTY_COURIER",
              "UNDETERMINED"
            ],
            "title": "Responsible Party",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          }
        },
        "required": [
          "id",
          "shipment_id",
          "stage",
          "type",
          "priority",
          "status",
          "handling_mode",
          "responsible_party",
          "evidence_ids",
          "summary"
        ],
        "title": "CaseSummary",
        "type": "object"
      },
      "DeliveryMode": {
        "enum": [
          "in_house",
          "third_party"
        ],
        "title": "DeliveryMode",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "VALIDATION_ERROR",
              "STALE_VERSION",
              "IDEMPOTENCY_CONFLICT",
              "PROVIDER_UNAVAILABLE",
              "SERVICE_UNAVAILABLE",
              "INTERNAL_ERROR",
              "HTTP_ERROR",
              "CLOSURE_PENDING"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "EventEnvelope": {
        "additionalProperties": false,
        "properties": {
          "event_id": {
            "format": "uuid",
            "title": "Event Id",
            "type": "string"
          },
          "event_type": {
            "title": "Event Type",
            "type": "string"
          },
          "warehouse_id": {
            "format": "uuid",
            "title": "Warehouse Id",
            "type": "string"
          },
          "sme_id": {
            "format": "uuid",
            "title": "Sme Id",
            "type": "string"
          },
          "entity_id": {
            "format": "uuid",
            "title": "Entity Id",
            "type": "string"
          },
          "actor_id": {
            "anyOf": [
              {
                "format": "uuid",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Actor Id"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "schema_version": {
            "const": 1,
            "title": "Schema Version",
            "type": "integer"
          },
          "idempotency_key": {
            "format": "uuid",
            "title": "Idempotency Key",
            "type": "string"
          },
          "payload": {
            "additionalProperties": true,
            "title": "Payload",
            "type": "object"
          }
        },
        "required": [
          "event_id",
          "event_type",
          "warehouse_id",
          "sme_id",
          "entity_id",
          "actor_id",
          "occurred_at",
          "schema_version",
          "idempotency_key",
          "payload"
        ],
        "title": "EventEnvelope",
        "type": "object"
      },
      "IdentityResponse": {
        "properties": {
          "actor_id": {
            "type": "string",
            "format": "uuid",
            "title": "Actor Id"
          },
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MembershipDTO"
            },
            "type": "array",
            "title": "Memberships"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "actor_id",
          "memberships"
        ],
        "title": "IdentityResponse"
      },
      "MembershipDTO": {
        "properties": {
          "warehouse_id": {
            "type": "string",
            "format": "uuid",
            "title": "Warehouse Id"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "staff",
              "sme",
              "rider"
            ],
            "title": "Role"
          },
          "sme_id": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sme Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "warehouse_id",
          "role",
          "sme_id"
        ],
        "title": "MembershipDTO"
      },
      "PendingAnalysis": {
        "additionalProperties": false,
        "properties": {
          "job_id": {
            "format": "uuid",
            "title": "Job Id",
            "type": "string"
          },
          "case_id": {
            "format": "uuid",
            "title": "Case Id",
            "type": "string"
          },
          "status": {
            "const": "pending",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "job_id",
          "case_id",
          "status"
        ],
        "title": "PendingAnalysis",
        "type": "object"
      },
      "ReceiptLine": {
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "format": "uuid",
            "title": "Product Id",
            "type": "string"
          },
          "received_qty": {
            "minimum": 0,
            "title": "Received Qty",
            "type": "integer"
          },
          "damaged_qty": {
            "minimum": 0,
            "title": "Damaged Qty",
            "type": "integer"
          }
        },
        "required": [
          "product_id",
          "received_qty",
          "damaged_qty"
        ],
        "title": "ReceiptLine",
        "type": "object"
      },
      "ReceiptRequest": {
        "additionalProperties": false,
        "properties": {
          "expected_version": {
            "minimum": 1,
            "title": "Expected Version",
            "type": "integer"
          },
          "final": {
            "title": "Final",
            "type": "boolean"
          },
          "lines": {
            "items": {
              "$ref": "#/components/schemas/ReceiptLine"
            },
            "minItems": 1,
            "title": "Lines",
            "type": "array"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "notes": {
            "title": "Notes",
            "type": "string"
          }
        },
        "required": [
          "expected_version",
          "final",
          "lines",
          "evidence_ids",
          "notes"
        ],
        "title": "ReceiptRequest",
        "type": "object"
      },
      "ReceiptResult": {
        "additionalProperties": false,
        "properties": {
          "shipment": {
            "$ref": "#/components/schemas/Shipment"
          },
          "expected_qty": {
            "minimum": 1,
            "title": "Expected Qty",
            "type": "integer"
          },
          "received_qty": {
            "minimum": 0,
            "title": "Received Qty",
            "type": "integer"
          },
          "good_qty": {
            "minimum": 0,
            "title": "Good Qty",
            "type": "integer"
          },
          "damaged_qty": {
            "minimum": 0,
            "title": "Damaged Qty",
            "type": "integer"
          },
          "shortage_qty": {
            "minimum": 0,
            "title": "Shortage Qty",
            "type": "integer"
          },
          "case_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Case Ids",
            "type": "array"
          }
        },
        "required": [
          "shipment",
          "expected_qty",
          "received_qty",
          "good_qty",
          "damaged_qty",
          "shortage_qty",
          "case_ids"
        ],
        "title": "ReceiptResult",
