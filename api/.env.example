# Leave integrations disabled for the first demo deployment.
SUPABASE_URL=
SUPABASE_KEY=
# Public/publishable key only. SUPABASE_KEY above is legacy and unused.
SUPABASE_PUBLIC_KEY=
CORS_ORIGINS=["http://localhost:3000"]
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# Independent checker call; configure explicitly (no implicit maker-model fallback).
OPENAI_CHECKER_MODEL=gpt-5.4
# Trusted worker only; never use as SUPABASE_PUBLIC_KEY or in NEXT_PUBLIC_*.
SUPABASE_WORKER_KEY=

# Free openrouteservice Standard API key (server only; never NEXT_PUBLIC_).
OPENROUTESERVICE_API_KEY=
# Separate checker request, independent context; configure a vision-capable model.
OPENAI_CHECKER_MODEL=
# Opt-in only after migration, policy review and staging acceptance tests.
AI_AUTO_EXECUTE=false

# Stock categorization: Groq free-plan model (separate from exception AI).
CATEGORIZATION_PROVIDER=groq
CATEGORIZATION_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
# Local alternative: CATEGORIZATION_PROVIDER=ollama, CATEGORIZATION_MODEL=qwen3:4b
OLLAMA_URL=http://127.0.0.1:11434
